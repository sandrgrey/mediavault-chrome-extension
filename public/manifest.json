{
  "manifest_version": 3,
  "name": "MediaVault",
  "version": "0.1.0",
  "description": "Локальный архив публикаций Instagram. Предварительная сборка.",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Открыть MediaVault" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    { "matches": ["https://www.instagram.com/*"], "js": ["page-bridge.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_start", "world": "ISOLATED" }
  ]
}
